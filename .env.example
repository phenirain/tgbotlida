# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Webhook URL (optional). If set, bot runs in webhook mode on port 8080.
# Leave empty to use long polling instead.
# Example: https://yourdomain.com
WEBHOOK_URL=https://success-is-close.ru/cream-soda-hysteria

# PostgreSQL Database Connection URL
# Format: postgres://username:password@hostname:port/database_name?sslmode=disable
DATABASE_URL=postgres://bot_user:bot_password@postgres:5432/bot_db?sslmode=disable

# Welcome message shown when user starts the bot
WELCOME_MESSAGE=Добро пожаловать в Sidneywood, друг!\nПеред тем, как погрузиться в мир альбома "77" на ближайшую неделю, нам нужно серьезно поговорить

# Photo URL to attach to welcome message (optional)
# Can be:
# - Direct URL: https://example.com/photo.jpg
# - Local file path: ./assets/welcome.jpg or /app/assets/welcome.jpg (inside Docker)
# - Telegram file_id (after first upload)
# Leave empty to send only text without photo
PHOTO_URL=./assets/welcome.jpg

# Policy text that user must accept
POLICY_TEXT=Чтобы участвовать в конкурсе на прослушивания альбома, прими согласие об обработке твоих персональных данных. Я даю согласие на обработку моих персональных данных (ИП Ромадов Николай Вячеславич, ИНН 482620678063) в целях проведения конкурса на прослушивание альбома Lida - 77, включая сбор, хранение, использование, передачу обработчикам. Согласие действует до оглашения результатов конкурса.

SECOND_MESSAGE=А чтобы мы могли связаться с тобой по результатам конкурса - введи свою почту, с которой ты авторизирован в Яндекс.Музыке

# Final message after email is saved
FINAL_MESSAGE=Ты выполнил задание на 5 с плюсом! Теперь осталось самое важное - следующие 7 дней непрерывно слушать "77"   и ждать результатов - вперед!

ALBUM_LINK=https://koala-music.com