# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Welcome message shown when user starts the bot
WELCOME_MESSAGE=Welcome to our bot! We're glad to have you here.

# Policy text that user must accept
POLICY_TEXT=By clicking Accept, you agree to our policy on the provision and use of personal data. We will use your email only for authorized purposes and will not share it with third parties.

# Final message after email is saved
FINAL_MESSAGE=Thank you! Your email has been successfully saved. We'll contact you soon.
